# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
*.tsbuildinfo

# Required source helper; parent vault ignores build directories.
!/build/
!/build/sites-vite-plugin.ts

# Wrangler local secrets. Never commit: this is where ANTHROPIC_API_KEY lives.
.dev.vars
.dev.vars.*

# Captured vault content. Generated locally, never committed: these modules
# hold real prose from a private vault, and a record marked shareable can
# still discuss sequences, vendors and prices in its own body. Regenerate with
# scripts/build-captured-program.mjs, then scripts/select-audience.mjs.
lib/workspace/captured/*.ts
# ...except the selector, so the repository builds out of the box with no capture.
!lib/workspace/captured/active.ts
integrations/vault/specs/
